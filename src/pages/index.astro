---
import Layout from "../layouts/BaseLayout.astro";
import bannerImage from "../assets/main/home/discord profile banner.png";
import "../styles/_index.scss";
import { Image } from "astro:assets";
---

<Layout title="atypicalcomplextimesignatures">
  <section class="main">
    <Image
      id="banner"
      src={bannerImage}
      alt="Banner"
    />
    <div id="gradient"></div>
    <div id="text">
      <h1 id="name"><b>Svenja</b></h1>
      <h1 id="ipa">/ˈsvɛn.ja/</h1>
    </div>
    <div id="shields">
      <a
        href="https://x.com/actsignatures"
        target="_blank"
        rel="noopener noreferrer"
      >
        <img
          alt="Main Twitter Badge"
          src="https://img.shields.io/badge/twitter%20(main)-1DA1F2?style=flat"
        />
      </a>
      <a
        href="https://x.com/sognakunst"
        target="_blank"
        rel="noopener noreferrer"
      >
        <img
          alt="Art Twitter Badge"
          src="https://img.shields.io/badge/twitter%20(art)-1DA1F2?style=flat"
        />
      </a>
      <a
        href="https://discord.com/users/128237634383380480"
        target="_blank"
        rel="noopener noreferrer"
      >
        <img
          alt="Discord Badge"
          src="https://img.shields.io/badge/discord-5865F2?style=flat"
        />
      </a>
      <a
        href="https://anilist.co/user/Svenja/"
        target="_blank"
        rel="noopener noreferrer"
      >
        <img
          alt="Anilist Badge"
          src="https://img.shields.io/badge/anilist-02a9ff?style=flat"
        />
      </a>
      <a
        href="https://steamcommunity.com/id/atypicalcomplextimesignatures"
        target="_blank"
        rel="noopener noreferrer"
      >
        <img
          alt="Steam Badge"
          src="https://img.shields.io/badge/steam-1D396C?style=flat"
        />
      </a>
      <a
        href="https://open.spotify.com/user/tokumeino_kuuhaku"
        target="_blank"
        rel="noopener noreferrer"
      >
        <img
          alt="Spotify Badge"
          src="https://img.shields.io/badge/spotify-1ED760?style=flat"
        />
      </a>
      <a
        href="https://myfigurecollection.net/profile/Svenja"
        target="_blank"
        rel="noopener noreferrer"
      >
        <img
          alt="MyFigureCollection Badge"
          src="https://img.shields.io/badge/myfigurecollection-6b9f5b?style=flat"
        />
      </a>
      <a
        href="https://www.youtube.com/@atypicalcomplextimesignatures"
        target="_blank"
        rel="noopener noreferrer"
      >
        <img
          alt="YouTube Badge"
          src="https://img.shields.io/badge/youtube-b2071d?style=flat"
        />
      </a>
      <a
        href="https://vndb.org/u292866/ulist?vnlist=1"
        target="_blank"
        rel="noopener noreferrer"
      >
        <img
          alt="VNDB Badge"
          src="https://img.shields.io/badge/vndb-200B0C?style=flat"
        />
      </a>
      <a
        href="https://osu.ppy.sh/users/10974678"
        target="_blank"
        rel="noopener noreferrer"
      >
        <img
          alt="Osu! Badge"
          src="https://img.shields.io/badge/osu!-FF64A1?style=flat"
        />
      </a>
