---
import Navbar from "../components/Navbar.astro";
import "../styles/global.scss";
const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cascadia+Mono:ital,wght@0,200..700;1,200..700&family=Gentium+Book+Plus:ital,wght@0,400;0,700;1,400;1,700&family=Kotta+One&family=Secular+One&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Navbar />
    <main>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  body,
  html {
    margin: 0;
    padding: 0;
    font-family: sans-serif;
  }
</style>
